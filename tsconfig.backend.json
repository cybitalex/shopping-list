{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/backend",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server.js", "src/services/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.tsx",
    "test-*.ts",
    "src/services/products.ts"
  ]
}

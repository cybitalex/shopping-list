FROM node:20-alpine

# Install git for some packages that need it
RUN apk add --no-cache git

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy app source
COPY . .

# Expose port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "start:frontend"] 
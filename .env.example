# API Keys - NEVER commit actual keys to the repository
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MAPBOX_TOKEN=your_mapbox_token_here

# Server Configuration
PORT=3000
VITE_BACKEND_URL=http://localhost:3000

# Frontend Configuration
VITE_FRONTEND_URL=http://localhost:5173
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_ID=your_google_maps_id_here
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Scraping Configuration
ENABLE_PLAYWRIGHT=true
ENABLE_AI_EXTRACTION=true
USE_GOOGLE_SEARCH=true
PLAYWRIGHT_HEADLESS=true
SERPER_API_KEY=your_serper_api_key_here

# DuckDNS Configuration - REQUIRED FOR DOCKER DEPLOYMENT
DUCKDNS_SUBDOMAIN=your_subdomain
DUCKDNS_TOKEN=your_duckdns_token

# Let's Encrypt Configuration - REQUIRED FOR HTTPS
LETSENCRYPT_EMAIL=your_email@example.com